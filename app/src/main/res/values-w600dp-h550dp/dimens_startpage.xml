<?xml version="1.0" encoding="utf-8"?>
<!--
    Roomy screens: the bigger head units (1024x600, 1280x720, 1920x720) and tablets.
    The available-height qualifier outranks orientation, so this replaces values-land on
    a wide car screen that is actually tall enough for a full-size tile; a 800x480 unit
    (h480dp) never reaches this bucket.

    Page padding is 28dp on sw600dp devices:
      1024dp -> 968dp available -> 6 cols = 161dp (< 220dp min) -> 3 columns of 322dp x 2 rows
      1280dp -> 1224dp available -> 3 columns capped at 360dp, grid centred (72dp gutters)
      1920dp -> 1864dp available -> 6 columns of 310dp in one row, full width
-->
<resources>
    <dimen name="start_page_grid_min_tile_width">220dp</dimen>
    <dimen name="start_page_grid_max_tile_width">360dp</dimen>

    <dimen name="start_page_slot_gap">8dp</dimen>
    <dimen name="start_page_slot_min_height">140dp</dimen>
    <dimen name="start_page_slot_padding_h">16dp</dimen>
    <dimen name="start_page_slot_padding_v">12dp</dimen>
    <dimen name="start_page_slot_icon_size">56dp</dimen>
    <dimen name="start_page_slot_icon_gap">10dp</dimen>

    <dimen name="start_page_slot_title_size">18sp</dimen>
    <dimen name="start_page_slot_title_min_size">13sp</dimen>
    <dimen name="start_page_slot_label_size">13sp</dimen>
    <integer name="start_page_slot_title_lines">2</integer>
    <bool name="start_page_slot_show_label">true</bool>

    <dimen name="start_page_resume_icon_size">48dp</dimen>
    <dimen name="start_page_resume_row_min_height">72dp</dimen>
    <dimen name="start_page_resume_padding_v">10dp</dimen>
    <dimen name="start_page_resume_corner">22dp</dimen>
    <bool name="start_page_resume_compact">false</bool>

    <!-- Vertical rhythm between header, resume card and grid (activity_main.xml). -->
    <dimen name="start_page_section_gap">16dp</dimen>
</resources>
