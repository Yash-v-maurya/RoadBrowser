<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline along the top edge of the bottom control strip: separates chrome from page
     without the shadow a floating bar would need. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerLow" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>
