<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick-link tile. Flat by design: the surface and its hairline edge are built in
    StartPageAdapter from theme attributes, so there is no elevation and no shadow here.
    Sizing comes from values*/dimens_startpage.xml, which is where the per-screen
    proportions live (short car screens drop the URL line and shorten the tile).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/start_page_slot_gap">

    <LinearLayout
        android:id="@+id/slotContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="@dimen/start_page_slot_min_height"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/start_page_slot_padding_h"
        android:paddingEnd="@dimen/start_page_slot_padding_h"
        android:paddingTop="@dimen/start_page_slot_padding_v"
        android:paddingBottom="@dimen/start_page_slot_padding_v">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Auto-sizing: a long one-word label shrinks a step or two rather than
             ellipsizing into "Keepandroidop...". -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/start_page_slot_icon_gap"
            android:gravity="center"
            android:maxLines="@integer/start_page_slot_title_lines"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:breakStrategy="simple"
            android:textAppearance="@style/TextAppearance.RoadBrowser.TitleMedium"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="@dimen/start_page_slot_title_min_size"
            app:autoSizeMaxTextSize="@dimen/start_page_slot_title_size"
            app:autoSizeStepGranularity="1sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.RoadBrowser.BodySmall"
            android:textSize="@dimen/start_page_slot_label_size" />
    </LinearLayout>
</FrameLayout>
