        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.RoadBrowser.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.RoadBrowser.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.RoadBrowser.ExtraLarge</item>
        <item name="materialCardViewStyle">@style/Widget.RoadBrowser.Card</item>
    </style>

    <!-- Circular Image Shape -->
    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Bottom Sheet Shape -->
    <style name="ShapeAppearanceOverlay.App.Card.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Typography: Manrope everywhere, weight by role -->
    <style name="TextAppearance.RoadBrowser.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/roadbrowser_sans</item>
        <item name="android:fontFamily">@font/roadbrowser_sans</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.RoadBrowser.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
